# light-load keeps NO ROM data. Block ROM/image formats from being committed here.
*.nes
*.zip
*.sfc
*.smc
*.gb
*.gba
*.n64
*.z64
*.rom
*.bin
# Local working copies produced by the editor:
*.edited.nes

# NTS build artifacts (compiled from nts/ sources):
nts/*.o
nts/c-ines-reader/*.o
nts/cpp-discriminator/*.o
nts/nts-analyze
