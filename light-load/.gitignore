# light-load keeps NO ROM data. Block ROM/image formats from being committed here.
*.nes
*.zip
*.sfc
*.smc
*.gb
*.gba
*.n64
*.z64
*.rom
*.bin
# Local working copies produced by the editor:
*.edited.nes

# NTS build artifacts (compiled from nts/ sources):
nts/*.o
nts/**/*.o
nts/nts-analyze
nts/nts-canvas

# Canvas generator: 16-byte header declarations (*.ineshdr) are safe to commit.
# Full zeroed canvas bodies are large and must never be committed:
*.canvas.nes
nts/*.nes

# Java tool build output:
nts/java-rom-tool/out/
*.class

# tools build outputs (compiled from tools/ sources) and example artifacts:
tools/asm6502/asm6502
tools/chr-encoder/chr_encode
tools/audio-builder/audio_build
tools/exec-harness/exec6502
tools/examples/*.bin
tools/examples/*.chr
tools/examples/*.snd
